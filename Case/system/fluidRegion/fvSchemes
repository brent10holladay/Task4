FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default             Euler;
}

gradSchemes
{
    // default             Gauss linear;
    default              cellLimited Gauss linear 1;
}

divSchemes
{
    default                none;
    div(alphaRhoPhi,U)     Gauss upwind;
    div(alphaRhoPhiNu,U)   Gauss linear;

    turbulence             Gauss upwind;
    div(alphaRhoPhi,omega) $turbulence;
    div(alphaRhoPhi,k)     $turbulence;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}


