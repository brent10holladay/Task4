// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          1;

writeControl    adjustableRunTime;

writeInterval   50;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

solveFluidMechanics false;

solveEnergy     false;

solveNeutronics true;

solveThermalMechanics false;

liquidFuel      true;

adjustTimeStep  false;

maxDeltaT       1;

maxCo           1;

maxPowerVariation 0.025;

regionSolvers
{
    fluidRegion      onePhase;
    neutroRegion     diffusionNeutronics;
}

#include "functions"


