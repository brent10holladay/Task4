// Salt density (@ 911.15 K)
// rho = 2.3275 g/cc
// Source: IRPhEP, 2021 Section 1.1.3 / Fratoni, 2020 Table 4.4

// Dynamic viscosity (mu) [Pa*s]
// mu = 0.008 Pa*s
// Kinematic viscosity (nu) [J*s/kg]
// nu = 3.437e-06

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       43.55;
    }
    thermodynamics
    {
        Cp              1982.4;
        Hf              0;
    }
    transport
    {
        mu              8e-03;
        Pr              10.65;
    }
    equationOfState
    {
        rho             2327.5;
        T0              911;
    }
}

