FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      defaultFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 -2 -1 0 0 0 0 ];

internalField   uniform 1;

boundaryField
{
    control_rods
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall_external
    {
        type            albedoSP3;
        gamma           0.3893298;
        diffCoeffName   Dalbedo;
        fluxStarAlbedo  fluxStarAlbedo;
        forSecondMoment 0;
        value           uniform 1;
    }
    bottom
    {
        type            albedoSP3;
        gamma           0.2997985;
        diffCoeffName   Dalbedo;
        fluxStarAlbedo  fluxStarAlbedo;
        forSecondMoment 0;
        value           uniform 1;
    }
}

